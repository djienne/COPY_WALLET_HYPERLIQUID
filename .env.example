# Copy to .env (git-ignored) and fill in. Freqtrade reads FREQTRADE__<SECTION>__<KEY> variables.

# Hyperliquid wallet to copy (0x + 40 hex digits)
FREQTRADE__COPY_ADDRESS=

# REST API / FreqUI login. Generate fresh values, e.g. `python -c "import secrets; print(secrets.token_hex(32))"`
FREQTRADE__API_SERVER__USERNAME=ft
FREQTRADE__API_SERVER__PASSWORD=
FREQTRADE__API_SERVER__JWT_SECRET_KEY=

# Live trading only (leave empty for dry run). Use a Hyperliquid API wallet key
# (can trade, cannot withdraw), never the main wallet's private key.
FREQTRADE__EXCHANGE__WALLET_ADDRESS=
FREQTRADE__EXCHANGE__PRIVATE_KEY=
